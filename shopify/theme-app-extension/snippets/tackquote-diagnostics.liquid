{% doc %}
  Merchant-only diagnostics for the read blocks, as data attributes on the
  block's root element. Emitted ONLY in the theme editor, so a shopper's page
  never carries them. `ns.explain` in tackquote-shared.js picks one by the
  failure it saw; the price, quantity-breaks and order-limits blocks share it.

  @example
  <div {% render 'tackquote-diagnostics' %}></div>
{% enddoc %}
{%- if request.design_mode -%}
  data-msg-diag-password="{{ 'tackquote.diagnostics.password' | t | escape }}"
  data-msg-diag-not-json="{{ 'tackquote.diagnostics.not_json' | t | escape }}"
  data-msg-diag-404="{{ 'tackquote.diagnostics.not_found' | t | escape }}"
  data-msg-diag-auth="{{ 'tackquote.diagnostics.auth' | t | escape }}"
  data-msg-diag-5xx="{{ 'tackquote.diagnostics.server' | t | escape }}"
  data-msg-diag-timeout="{{ 'tackquote.diagnostics.timeout' | t | escape }}"
  data-msg-diag-fail="{{ 'tackquote.diagnostics.failed' | t | escape }}"
  data-msg-diag-not-connected="{{ 'tackquote.diagnostics.not_connected' | t | escape }}"
  data-msg-diag-no-sku="{{ 'tackquote.diagnostics.no_sku' | t | escape }}"
  data-msg-diag-no-limits="{{ 'tackquote.diagnostics.no_limits' | t | escape }}"
{%- endif -%}
