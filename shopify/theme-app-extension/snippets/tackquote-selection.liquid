{%- comment -%}
  README.md, Liquid design notes: tackquote-selection.liquid (1). `price` (cents,
  presentment currency) is for DISPLAY in the drawer only; it is never sent.
  @param {product} product
{%- endcomment -%}
<script type="application/json" class="tackquote-variants">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id | json }},
        "sku": {{ variant.sku | default: '' | json }},
        "title": {{ variant.title | json }},
        "available": {{ variant.available | json }},
        "price": {{ variant.price | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>
