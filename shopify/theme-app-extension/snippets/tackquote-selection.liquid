{%- comment -%}
  README.md, Liquid design notes: tackquote-selection.liquid (1).
  @param {product} product - The product whose variants should be emitted.
{%- endcomment -%}
<script type="application/json" class="tackquote-variants">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id | json }},
        "sku": {{ variant.sku | default: '' | json }},
        "title": {{ variant.title | json }},
        "available": {{ variant.available | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>
