{%- comment -%}
  README notes: tackquote-visibility (1). Mirrors is_entitled
  in shopify/functions/contract/contract.rs.
  @param {product} product
{%- endcomment -%}
{%- liquid
  assign vis = product.metafields['$app'].visibility.value
  assign restricted = false
  assign entitled = true
  if vis != blank and vis.v == 2
    if vis.a != blank or vis.d != blank
      assign restricted = true
    endif
  endif

  if restricted
    assign linked = false
    assign groups = ''
    if customer
      assign membership = customer.metafields['$app'].groups.value
      if membership != blank and membership.v == 2
        assign linked = true
        assign groups = membership.g
      endif
    endif

    if linked and vis.d != blank
      for k in vis.d
        if k == '*' or groups contains k
          assign entitled = false
          break
        endif
      endfor
    endif

    if entitled and vis.a != blank
      assign entitled = false
      if linked
        for k in vis.a
          if k == '*' or groups contains k
            assign entitled = true
            break
          endif
        endfor
      endif
    endif
  endif
-%}
{%- if restricted -%}
  {%- if request.design_mode -%}
    <p class="tackquote-setup tackquote-visibility-note">{{ 'tackquote.visibility.editor_note' | t }}</p>
  {%- elsif entitled == false -%}
    hidden
  {%- endif -%}
{%- endif -%}
