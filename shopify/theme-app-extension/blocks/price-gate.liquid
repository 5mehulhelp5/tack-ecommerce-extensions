{%- liquid
  assign gated = false
  assign want_tag = block.settings.tag | strip | downcase
  if customer == blank
    assign gated = true
  elsif block.settings.mode == 'tag' and want_tag != blank
    assign gated = true
    for customer_tag in customer.tags
      assign have_tag = customer_tag | strip | downcase
      if have_tag == want_tag
        assign gated = false
        break
      endif
    endfor
  endif

  assign extra = block.settings.extra_selectors | strip
  assign extra_ok = true
  if extra contains '{' or extra contains '}' or extra contains '<' or extra contains '/*'
    assign extra_ok = false
  endif
  if extra contains '@' or extra contains ';'
    assign extra_ok = false
  endif

  assign login_url = routes.storefront_login_url | default: routes.account_login_url
  assign message = block.settings.message | strip
  if message == blank
    assign message = 'tackquote.gate.login' | t
  endif
-%}

{%- if request.design_mode -%}
  <div class="tackquote-gate-editor" role="note">
    <strong>{{ 'tackquote.gate.editor_title' | t }}</strong>
    <span>
      {%- if block.settings.mode == 'tag' -%}
        {{ 'tackquote.gate.editor_tag' | t }} {{ want_tag | escape }}
      {%- else -%}
        {{ 'tackquote.gate.editor_guests' | t }}
      {%- endif -%}
    </span>
    {%- unless extra_ok -%}
      <span>{{ 'tackquote.gate.editor_bad_selectors' | t }}</span>
    {%- endunless -%}
  </div>
  <style>
    .tackquote-gate-editor { position: fixed; bottom: 12px; left: 12px; z-index: 2147483000; max-width: 22rem; padding: 10px 12px; background: #fff; color: #111; border: 1px solid #111; font: 13px/1.4 system-ui, sans-serif; display: flex; flex-direction: column; gap: 4px; }
  </style>
{%- elsif gated -%}
  <style>
    .price, .price__container, .price-item, price-per-item, .product__price, .product-price, [data-product-price], [data-price], .card-information .price, .unit-price{% if extra_ok and extra != blank %}, {{ extra }}{% endif %} { display: none !important; }
    {%- if block.settings.hide_cart %}
    form[action*="/cart/add"] [type="submit"]:not([class*="tackquote"]), form[action*="/cart/add"] button[name="add"], .product-form__submit, .shopify-payment-button, .quick-add, .quick-add__submit, quick-add-modal, .product-form__buttons [type="submit"] { display: none !important; }
    {%- endif %}
    .tackquote-gate__login { display: inline-block; margin: 0.25rem 0; font-weight: 600; text-decoration: underline; }
  </style>
  <div
    id="tackquote-price-gate"
    hidden
    data-login-url="{{ login_url | escape }}"
    data-msg="{{ message | escape }}"
    data-extra="{% if extra_ok %}{{ extra | escape }}{% endif %}"
  ></div>
{%- endif -%}

{% schema %}
{
  "name": "Price Gate",
  "target": "body",
  "javascript": "tackquote-price-gate.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Hides prices and the add to cart button from shoppers who should not see them, and shows a Log in to see prices link instead. This hides what the storefront DISPLAYS. It is not a checkout rule, and product data your theme publishes stays public."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Hide prices from",
      "options": [
        { "value": "guests", "label": "Shoppers who are not signed in" },
        { "value": "tag", "label": "Anyone without the wholesale tag" }
      ],
      "default": "guests"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Wholesale customer tag",
      "default": "wholesale",
      "info": "Used when hiding from anyone without the tag. TackQuote adds this tag when it approves a wholesale application."
    },
    {
      "type": "checkbox",
      "id": "hide_cart",
      "label": "Also hide add to cart and buy buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "message",
      "label": "Link text",
      "info": "Leave blank for: Log in to see prices"
    },
    {
      "type": "text",
      "id": "extra_selectors",
      "label": "Advanced: extra price selectors",
      "info": "Only if your theme shows prices somewhere this misses. Comma separated CSS selectors, for example .my-price. Braces, semicolons and @ are refused."
    }
  ]
}
{% endschema %}
