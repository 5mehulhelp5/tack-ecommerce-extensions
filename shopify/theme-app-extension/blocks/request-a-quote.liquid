{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | remove_last: '/'
  assign variant = product.selected_or_first_available_variant
-%}

{%- comment -%}
  Catalog visibility: a product restricted to TackQuote buyer groups offers
  no price, break, limit or quote control to a shopper who may not buy it.
  The rule, and why, is in snippets/tackquote-visibility.liquid.
{%- endcomment -%}
{%- capture tackquote_access -%}{% render 'tackquote-visibility', product: product %}{%- endcapture -%}
{%- assign tackquote_access = tackquote_access | strip -%}
{%- unless tackquote_access == 'hidden' -%}
{{ tackquote_access }}
{%- if proxy_path == blank -%}
  {%- if request.design_mode -%}
    <div class="tackquote-setup" {{ block.shopify_attributes }}>
      <strong>{{ 'tackquote.setup.title' | t }}</strong>
      <p>{{ 'tackquote.setup.proxy' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
  <div
    class="tackquote-block tackquote-request"
    data-tackquote-mode="request"
    data-tackquote-proxy="{{ proxy_path | escape }}"
    data-tackquote-product="{{ product.title | escape }}"
    data-tackquote-variant="{{ variant.id }}"
    data-tackquote-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    {%- if customer %}
      data-tackquote-customer-name="{{ customer.name | escape }}"
      data-tackquote-customer-email="{{ customer.email | escape }}"
    {%- endif %}
    {{ block.shopify_attributes }}
  >
    {% render 'tackquote-selection', product: product %}
    <button
      type="button"
      class="tackquote-button tackquote-button--{{ block.settings.button_style }}{% if block.settings.button_style == 'theme' %} button btn{% endif %}"
      data-tackquote-action="request"
    >
      {%- comment -%}The schema default is English. Left as it is (or blank), the
      shopper's language is used instead; a merchant's own wording is kept.{%- endcomment -%}
      {%- assign tackquote_label = block.settings.button_label | strip -%}
      {%- if tackquote_label == blank or tackquote_label == 'Request a Quote' -%}
        {%- assign tackquote_label = 'tackquote.quote.request_button' | t -%}
      {%- endif -%}
      {{ tackquote_label }}
    </button>
    {%- assign tackquote_helper = block.settings.helper_text | strip -%}
    {%- if tackquote_helper == 'Buying in volume? Ask us for a price.' -%}
      {%- assign tackquote_helper = 'tackquote.quote.helper' | t -%}
    {%- endif -%}
    {%- if tackquote_helper != blank -%}
      <p class="tackquote-helper">{{ tackquote_helper }}</p>
    {%- endif -%}
    <p class="tackquote-status" data-tackquote-status role="status" aria-live="polite"></p>
  </div>

  {% render 'tackquote-drawer' %}
  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Request a Quote",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "tackquote.css",
  "javascript": "tackquote-quote.js",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/tackquote",
      "info": "Must match the subpath configured for the TackQuote app proxy."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Request a Quote"
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Buying in volume? Ask us for a price."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "theme",
          "label": "Match my theme's buttons"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "theme"
    }
  ]
}
{% endschema %}
