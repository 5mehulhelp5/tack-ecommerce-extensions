{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | remove_last: '/'
  assign variant = product.selected_or_first_available_variant
-%}

{%- comment -%}
  Catalog visibility: a product restricted to TackQuote buyer groups offers
  no price, break, limit or quote control to a shopper who may not buy it.
  The rule, and why, is in snippets/tackquote-visibility.liquid.
{%- endcomment -%}
{%- capture tackquote_access -%}{% render 'tackquote-visibility', product: product %}{%- endcapture -%}
{%- assign tackquote_access = tackquote_access | strip -%}
{%- unless tackquote_access == 'hidden' -%}
{{ tackquote_access }}
{%- if proxy_path == blank -%}
  {%- if request.design_mode -%}
    <div class="tackquote-setup" {{ block.shopify_attributes }}>
      <strong>{{ 'tackquote.setup.title' | t }}</strong>
      <p>{{ 'tackquote.setup.proxy' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%}
    Kept OUTSIDE the tag's attribute list (see b5a4158: a Liquid tag between
    attributes failed `shopify app deploy`'s theme check).

    `data-tackquote-customer` is NOT identity: it only partitions the per-tab
    cache. The identity that decides the ladder is `logged_in_customer_id`,
    which Shopify injects into the proxy request and signs.
    `data-tackquote-design` suspends the fail-quiet behaviour so a merchant in
    the theme editor sees every state; a shopper sees only the useful ones.
  {%- endcomment -%}
  {%- capture tackquote_diagnostics -%}{% render 'tackquote-diagnostics' %}{%- endcapture -%}
  <div
    class="tackquote-block tackquote-breaks"
    data-tackquote-mode="quantity-breaks"
    data-tackquote-proxy="{{ proxy_path | escape }}"
    data-tackquote-variant="{{ variant.id }}"
    data-tackquote-login-url="{{ routes.account_login_url }}"
    data-tackquote-customer="{{ customer.id }}"
    data-tackquote-design="{% if request.design_mode %}true{% else %}false{% endif %}"
    data-msg-anonymous="{{ 'tackquote.quantity_breaks.anonymous' | t | escape }}"
    data-msg-login="{{ 'tackquote.quantity_breaks.login' | t | escape }}"
    data-msg-unlinked="{{ 'tackquote.quantity_breaks.unlinked' | t | escape }}"
    data-msg-caption="{{ 'tackquote.quantity_breaks.caption' | t | escape }}"
    data-msg-quantity="{{ 'tackquote.quantity_breaks.quantity' | t | escape }}"
    data-msg-price="{{ 'tackquote.quantity_breaks.price' | t | escape }}"
    data-msg-list-note="{{ 'tackquote.quantity_breaks.list_note' | t | escape }}"
    data-msg-empty="{{ 'tackquote.quantity_breaks.empty' | t | escape }}"
    data-msg-error="{{ 'tackquote.quantity_breaks.error' | t | escape }}"
    {{ tackquote_diagnostics }}
    {{ block.shopify_attributes }}
  >
    {% render 'tackquote-selection', product: product %}
    <h3 class="tackquote-breaks__heading">
      {%- comment -%}The schema default is English. Left as it is (or blank), the
      shopper's language is used instead; a merchant's own wording is kept.{%- endcomment -%}
      {%- assign tackquote_label = block.settings.heading | strip -%}
      {%- if tackquote_label == blank or tackquote_label == 'Wholesale quantity pricing' -%}
        {%- assign tackquote_label = 'tackquote.quantity_breaks.heading' | t -%}
      {%- endif -%}
      {{ tackquote_label }}
    </h3>
    <div class="tackquote-breaks__body" data-tackquote-breaks-body role="status" aria-live="polite">
      <p class="tackquote-breaks__loading">{{ 'tackquote.quantity_breaks.loading' | t }}</p>
    </div>
  </div>

  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Quantity Breaks",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "tackquote.css",
  "javascript": "tackquote-quantity-breaks.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the wholesale quantity-break ladder for this product, so buyers can request those prices on a quote. Every price comes from TackQuote's own pricing engine, so this table and the Wholesale Price block can never disagree."
    },
    {
      "type": "paragraph",
      "content": "Signed-in wholesale customers see their own ladder. Signed-out visitors see a sign-in prompt, or your public ladder if you have published one in TackQuote \u2014 see the Shopify connector guide."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/tackquote",
      "info": "Must match Settings > Apps and sales channels > TackQuote > App proxy. Change it here if you renamed the proxy URL there."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wholesale quantity pricing"
    }
  ]
}
{% endschema %}
