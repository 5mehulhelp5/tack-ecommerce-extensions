{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | remove_last: '/'
  assign variant = product.selected_or_first_available_variant
  assign auto_heading = false
  if block.settings.heading == blank or block.settings.heading == 'Wholesale quantity pricing'
    assign auto_heading = true
  endif
-%}

{%- comment -%}
  Catalog visibility: a product restricted to TackQuote buyer groups offers
  no price, break, limit or quote control to a shopper who may not buy it.
  The rule, and why, is in snippets/tackquote-visibility.liquid.
{%- endcomment -%}
{%- capture tackquote_access -%}{% render 'tackquote-visibility', product: product %}{%- endcapture -%}
{%- assign tackquote_access = tackquote_access | strip -%}
{%- unless tackquote_access == 'hidden' -%}
{{ tackquote_access }}
{%- if proxy_path == blank -%}
  {%- if request.design_mode -%}
    <div class="tackquote-setup" {{ block.shopify_attributes }}>
      <strong>{{ 'tackquote.setup.title' | t }}</strong>
      <p>{{ 'tackquote.setup.proxy' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%}
    Kept OUTSIDE the tag's attribute list (see b5a4158: a Liquid tag between
    attributes failed `shopify app deploy`'s theme check).

    `data-tackquote-customer` is NOT identity: it only partitions the per-tab
    cache. The identity that decides the ladder is `logged_in_customer_id`,
    which Shopify injects into the proxy request and signs.
    `data-tackquote-design` suspends the fail-quiet behaviour so a merchant in
    the theme editor sees every state; a shopper sees only the useful ones.
  {%- endcomment -%}
  {%- capture tackquote_diagnostics -%}{% render 'tackquote-diagnostics' %}{%- endcapture -%}
  {%- capture tq_style -%}{% render 'tackquote-style', s: block.settings %}{%- endcapture -%}
  {%- assign tq_attrs = tq_style | split: '-->' | last | split: '<!--' | first -%}
  <div
    class="tackquote-block tackquote-breaks"
    data-tackquote-mode="quantity-breaks"
    data-tackquote-proxy="{{ proxy_path | escape }}"
    data-tackquote-variant="{{ variant.id }}"
    data-tackquote-login-url="{{ routes.account_login_url }}"
    data-tackquote-customer="{{ customer.id }}"
    data-tackquote-design="{% if request.design_mode %}true{% else %}false{% endif %}"
    data-msg-anonymous="{{ 'tackquote.quantity_breaks.anonymous' | t | escape }}"
    data-msg-login="{{ 'tackquote.quantity_breaks.login' | t | escape }}"
    data-msg-unlinked="{{ 'tackquote.quantity_breaks.unlinked' | t | escape }}"
    data-msg-caption="{{ 'tackquote.quantity_breaks.caption' | t | escape }}"
    data-msg-caption-applied="{{ 'tackquote.quantity_breaks.caption_applied' | t | escape }}"
    data-msg-price-applied="{{ 'tackquote.quantity_breaks.price_applied' | t | escape }}"
    data-msg-applied-note="{{ 'tackquote.quantity_breaks.applied_note' | t | escape }}"
    data-msg-heading-quote="{{ 'tackquote.quantity_breaks.heading_quote' | t | escape }}"
    data-msg-heading-applied="{{ 'tackquote.quantity_breaks.heading_applied' | t | escape }}"
    data-tackquote-auto-heading="{{ auto_heading }}"
    data-msg-quantity="{{ 'tackquote.quantity_breaks.quantity' | t | escape }}"
    data-msg-price="{{ 'tackquote.quantity_breaks.price' | t | escape }}"
    data-msg-list-note="{{ 'tackquote.quantity_breaks.list_note' | t | escape }}"
    data-msg-empty="{{ 'tackquote.quantity_breaks.empty' | t | escape }}"
    data-msg-error="{{ 'tackquote.quantity_breaks.error' | t | escape }}"
    data-tackquote-currency="{{ cart.currency.iso_code }}"
    data-msg-currency-applied="{{ 'tackquote.currency.applied' | t | escape }}"
    data-msg-currency-quote="{{ 'tackquote.currency.quote' | t | escape }}"
    {{ tackquote_diagnostics | split: '-->' | last | split: '<!--' | first }}
    {{ tq_attrs }}
    {{ block.shopify_attributes }}
  >
    {% render 'tackquote-selection', product: product %}
    <h3 class="tackquote-breaks__heading">
      {%- if auto_heading -%}
        {{ 'tackquote.quantity_breaks.heading_quote' | t }}
      {%- else -%}
        {{ block.settings.heading }}
      {%- endif -%}
    </h3>
    <div class="tackquote-breaks__body" data-tackquote-breaks-body role="status" aria-live="polite">
      <p class="tackquote-breaks__loading">{{ 'tackquote.quantity_breaks.loading' | t }}</p>
    </div>
  </div>

  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
  <script src="{{ 'tackquote-theme.js' | asset_url }}" async></script>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Quantity Breaks",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "tackquote.css",
  "javascript": "tackquote-quantity-breaks.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the wholesale quantity-break ladder for this product. When checkout pricing is on in TackQuote the table says the prices are applied at checkout; otherwise they are offered on a quote. Every price comes from TackQuote's own pricing engine, so this table and the Wholesale Price block can never disagree."
    },
    {
      "type": "paragraph",
      "content": "Signed-in wholesale customers see their own ladder. Signed-out visitors see a sign-in prompt, or your public ladder if you have published one in TackQuote \u2014 see the Shopify connector guide."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "Advanced: app URL prefix",
      "default": "/apps/tackquote",
      "info": "Leave this as it is. Change it only if you renamed the TackQuote app proxy in Shopify (Settings, Apps and sales channels, TackQuote, App proxy)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank for a heading that says whether the prices are applied at checkout or available on a quote."
    },
    {"type":"header","content":"Style","info":"Match theme (or empty) uses your theme's fonts, colors, corners and buttons."},
    {"type":"select","id":"tq_size","label":"Text size","options":[{"value":"0.875","label":"Smaller"},{"value":"1","label":"Match theme"},{"value":"1.125","label":"Larger"},{"value":"1.25","label":"Largest"}],"default":"1"},
    {"type":"select","id":"tq_font","label":"Font","options":[{"value":"theme","label":"Match theme"},{"value":"system","label":"System font"}],"default":"theme"},
    {"type":"color","id":"tq_text","label":"Text color"},
    {"type":"color","id":"tq_bg","label":"Background color"},
    {"type":"color","id":"tq_accent","label":"Button color"},
    {"type":"color","id":"tq_accent_text","label":"Button text color"},
    {"type":"select","id":"tq_radius","label":"Corner radius","options":[{"value":"theme","label":"Match theme"},{"value":"0","label":"Square"},{"value":"4","label":"Slight"},{"value":"8","label":"Rounded"},{"value":"12","label":"More rounded"},{"value":"999","label":"Pill"}],"default":"theme"}
  ]
}
{% endschema %}
