{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | remove_last: '/'
  assign variant = product.selected_or_first_available_variant
  assign auto_heading = false
  if block.settings.heading == blank or block.settings.heading == 'Your quoted wholesale price'
    assign auto_heading = true
  endif
-%}

{%- if proxy_path == blank -%}
  {%- if request.design_mode -%}
    <div class="tackquote-setup" {{ block.shopify_attributes }}>
      <strong>{{ 'tackquote.setup.title' | t }}</strong>
      <p>{{ 'tackquote.setup.proxy' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%}
    Kept OUTSIDE the tag's attribute list: a Liquid tag between attributes
    failed `shopify app deploy`'s theme check on another block (b5a4158).

    Two attributes below are NOT identity and must never be read as such.
    `data-tackquote-customer` only partitions the per-tab price cache, so that
    logging out in the same tab cannot surface the price the previous session
    was entitled to see. The identity that decides the price is
    `logged_in_customer_id`, which Shopify injects into the proxy request and
    signs; anything emitted here is just markup a shopper can edit.
    `data-tackquote-design` suspends the fail-quiet behaviour: a merchant placing
    the block in the theme editor needs to see every state, a shopper does not.
  {%- endcomment -%}
  {%- capture tackquote_diagnostics -%}{% render 'tackquote-diagnostics' %}{%- endcapture -%}
  <div
    class="tackquote-block tackquote-price"
    data-tackquote-mode="price"
    data-tackquote-proxy="{{ proxy_path | escape }}"
    data-tackquote-variant="{{ variant.id }}"
    data-tackquote-login-url="{{ routes.account_login_url }}"
    data-tackquote-customer="{{ customer.id }}"
    data-tackquote-design="{% if request.design_mode %}true{% else %}false{% endif %}"
    data-msg-anonymous="{{ 'tackquote.price.anonymous' | t | escape }}"
    data-msg-login="{{ 'tackquote.price.login' | t | escape }}"
    data-msg-unlinked="{{ 'tackquote.price.unlinked' | t | escape }}"
    data-msg-unpriced="{{ 'tackquote.price.unpriced' | t | escape }}"
    data-msg-each="{{ 'tackquote.price.each' | t | escape }}"
    data-msg-list-note="{{ 'tackquote.price.list_note' | t | escape }}"
    data-msg-quote-note="{{ 'tackquote.price.quote_note' | t | escape }}"
    data-msg-applied-note="{{ 'tackquote.price.applied_note' | t | escape }}"
    data-msg-anonymous-applied="{{ 'tackquote.price.anonymous_applied' | t | escape }}"
    data-msg-heading-quote="{{ 'tackquote.price.heading_quote' | t | escape }}"
    data-msg-heading-applied="{{ 'tackquote.price.heading_applied' | t | escape }}"
    data-tackquote-auto-heading="{{ auto_heading }}"
    data-msg-error="{{ 'tackquote.price.error' | t | escape }}"
    {{ tackquote_diagnostics }}
    {{ block.shopify_attributes }}
  >
    {% render 'tackquote-selection', product: product %}
    <h3 class="tackquote-price__heading">
      {%- if auto_heading -%}
        {{ 'tackquote.price.heading_quote' | t }}
      {%- else -%}
        {{ block.settings.heading }}
      {%- endif -%}
    </h3>
    <div class="tackquote-price__body" data-tackquote-price-body role="status" aria-live="polite">
      <p class="tackquote-price__loading">{{ 'tackquote.price.loading' | t }}</p>
    </div>
  </div>

  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Wholesale Price",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "tackquote.css",
  "javascript": "tackquote-price.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the signed-in customer's wholesale price. When checkout pricing is on in TackQuote the block says the price is applied at checkout; otherwise it offers the price on a quote. TackQuote resolves the price from the shopper's Shopify session, so it is never read from this page and a shopper cannot alter it."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "Advanced: app URL prefix",
      "default": "/apps/tackquote",
      "info": "Leave this as it is. Change it only if you renamed the TackQuote app proxy in Shopify (Settings, Apps and sales channels, TackQuote, App proxy)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank for a heading that follows your checkout setting."
    }
  ]
}
{% endschema %}
