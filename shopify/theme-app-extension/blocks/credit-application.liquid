{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | split: '/' | join: '/'
-%}

{%- if proxy_path == blank -%}
  {% render 'tackquote-setup', attrs: block.shopify_attributes %}
{%- else -%}
  {%- # README notes: credit-application (1) -%}
  {%- capture tq_style -%}{% render 'tackquote-style', s: block.settings %}{%- endcapture -%}
  {%- assign tq_attrs = tq_style | split: '-->' | last | split: '<!--' | first -%}
  <div
  class="tackquote-block tackquote-credit"
  data-tackquote-mode="credit-application"
  data-tackquote-proxy="{{ proxy_path | escape }}"
  data-tackquote-signed-in="{% if customer %}true{% else %}false{% endif %}"
  data-msg-sign-in="{{ 'tackquote.credit.sign_in' | t | escape }}"
  data-msg-label-business="{{ 'tackquote.credit.label_business' | t | escape }}"
  data-msg-label-email="{{ 'tackquote.credit.label_email' | t | escape }}"
  data-msg-label-phone="{{ 'tackquote.credit.label_phone' | t | escape }}"
  data-msg-label-tax-id="{{ 'tackquote.credit.label_tax_id' | t | escape }}"
  data-msg-label-limit="{{ 'tackquote.credit.label_limit' | t | escape }}"
  data-msg-label-terms="{{ 'tackquote.credit.label_terms' | t | escape }}"
  data-msg-label-notes="{{ 'tackquote.credit.label_notes' | t | escape }}"
  data-msg-submit="{{ 'tackquote.credit.submit' | t | escape }}"
  data-msg-submitting="{{ 'tackquote.credit.submitting' | t | escape }}"
  data-msg-success="{{ 'tackquote.credit.success' | t | escape }}"
  data-msg-already-pending="{{ 'tackquote.credit.already_pending' | t | escape }}"
  data-msg-too-large="{{ 'tackquote.credit.too_large' | t | escape }}"
  data-msg-error="{{ 'tackquote.credit.error' | t | escape }}"
  {{ tq_attrs }}
  {{ block.shopify_attributes }}
  >
  <h3 class="tackquote-credit__heading">
  {%- # README notes: credit-application (2) -%}
  {%- assign tackquote_label = block.settings.heading | strip -%}
  {%- if tackquote_label == blank or tackquote_label == 'Apply for net terms' -%}
  {%- assign tackquote_label = 'tackquote.credit.heading' | t -%}
  {%- endif -%}
  {{ tackquote_label }}
  </h3>
  <div class="tackquote-credit__body" data-tackquote-credit-body></div>
  </div>

  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
  <script src="{{ 'tackquote-theme.js' | asset_url }}" async></script>
{%- endif -%}

{% schema %}
{"name": "Net Terms Application", "target": "section", "enabled_on": {"templates": ["page"]}, "stylesheet": "tackquote.css", "javascript": "tackquote-credit.js","settings":[
    {"type":"paragraph","content":"t:tq.p.credit_application_1"},
    {"type":"paragraph","content":"Signed-out visitors see a prompt to sign in instead of a form, because an application has to belong to an account."},
    {"type":"text","id":"heading","label":"Heading","default":"Apply for net terms"},
    {"type":"text","id":"proxy_path","label":"t:tq.c.proxy","default":"/apps/tackquote","info":"t:tq.c.proxy_info"},
    {"type":"header","content":"t:tq.s.header","info":"t:tq.s.info"},
    {"type":"select","id":"tq_size","label":"t:tq.s.size","options":[{"value":"0.875","label":"t:tq.s.smaller"},{"value":"1","label":"t:tq.s.match"},{"value":"1.125","label":"t:tq.s.larger"},{"value":"1.25","label":"t:tq.s.largest"}],"default":"1"},
    {"type":"select","id":"tq_font","label":"t:tq.s.font","options":[{"value":"theme","label":"t:tq.s.match"},{"value":"system","label":"t:tq.s.system"}],"default":"theme"},
    {"type":"color","id":"tq_text","label":"t:tq.s.text"},
    {"type":"color","id":"tq_bg","label":"t:tq.s.bg"},
    {"type":"color","id":"tq_accent","label":"t:tq.s.accent"},
    {"type":"color","id":"tq_accent_text","label":"t:tq.s.accent_text"},
    {"type":"select","id":"tq_radius","label":"t:tq.s.radius","options":[{"value":"theme","label":"t:tq.s.match"},{"value":"0","label":"t:tq.s.square"},{"value":"4","label":"t:tq.s.slight"},{"value":"8","label":"t:tq.s.rounded"},{"value":"12","label":"t:tq.s.more_rounded"},{"value":"999","label":"t:tq.s.pill"}],"default":"theme"}
  ]}
{% endschema %}
