{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | remove_last: '/'
-%}

{%- if proxy_path == blank -%}
  {%- if request.design_mode -%}
    <div class="tackquote-setup" {{ block.shopify_attributes }}>
      <strong>{{ 'tackquote.setup.title' | t }}</strong>
      <p>{{ 'tackquote.setup.proxy' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
  {%- comment -%}
    Whether to draw the FORM or the sign-in prompt, and nothing more.

    The API refuses this route outright without a signed
    `logged_in_customer_id`, so a logged-out visitor must never be given a
    form to fill in — they would complete seven fields and be told to sign in.
    Liquid already knows, so the block decides here rather than spending one
    of the caller's three attempts per fifteen minutes discovering it.

    This is NOT identity. The identity is the customer id Shopify signs into
    the proxy request; a shopper editing this attribute gets a form whose
    submission the server then refuses.
  {%- endcomment -%}
  {%- capture tq_style -%}{% render 'tackquote-style', s: block.settings %}{%- endcapture -%}
  {%- assign tq_attrs = tq_style | split: '-->' | last | split: '<!--' | first -%}
  <div
    class="tackquote-block tackquote-credit"
    data-tackquote-mode="credit-application"
    data-tackquote-proxy="{{ proxy_path | escape }}"
    data-tackquote-signed-in="{% if customer %}true{% else %}false{% endif %}"
    data-msg-sign-in="{{ 'tackquote.credit.sign_in' | t | escape }}"
    data-msg-label-business="{{ 'tackquote.credit.label_business' | t | escape }}"
    data-msg-label-email="{{ 'tackquote.credit.label_email' | t | escape }}"
    data-msg-label-phone="{{ 'tackquote.credit.label_phone' | t | escape }}"
    data-msg-label-tax-id="{{ 'tackquote.credit.label_tax_id' | t | escape }}"
    data-msg-label-limit="{{ 'tackquote.credit.label_limit' | t | escape }}"
    data-msg-label-terms="{{ 'tackquote.credit.label_terms' | t | escape }}"
    data-msg-label-notes="{{ 'tackquote.credit.label_notes' | t | escape }}"
    data-msg-submit="{{ 'tackquote.credit.submit' | t | escape }}"
    data-msg-submitting="{{ 'tackquote.credit.submitting' | t | escape }}"
    data-msg-success="{{ 'tackquote.credit.success' | t | escape }}"
    data-msg-already-pending="{{ 'tackquote.credit.already_pending' | t | escape }}"
    data-msg-too-large="{{ 'tackquote.credit.too_large' | t | escape }}"
    data-msg-error="{{ 'tackquote.credit.error' | t | escape }}"
    {{ tq_attrs }}
    {{ block.shopify_attributes }}
  >
    <h3 class="tackquote-credit__heading">
      {%- comment -%}The schema default is English. Left as it is (or blank), the
      shopper's language is used instead; a merchant's own wording is kept.{%- endcomment -%}
      {%- assign tackquote_label = block.settings.heading | strip -%}
      {%- if tackquote_label == blank or tackquote_label == 'Apply for net terms' -%}
        {%- assign tackquote_label = 'tackquote.credit.heading' | t -%}
      {%- endif -%}
      {{ tackquote_label }}
    </h3>
    <div class="tackquote-credit__body" data-tackquote-credit-body></div>
  </div>

  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
  <script src="{{ 'tackquote-theme.js' | asset_url }}" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Net Terms Application",
  "target": "section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "stylesheet": "tackquote.css",
  "javascript": "tackquote-credit.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lets a signed-in wholesale customer apply for net payment terms. Applications land in TackQuote for review; nothing is approved automatically."
    },
    {
      "type": "paragraph",
      "content": "Signed-out visitors see a prompt to sign in instead of a form, because an application has to belong to an account."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "Advanced: app URL prefix",
      "default": "/apps/tackquote",
      "info": "Leave this as it is. Change it only if you renamed the TackQuote app proxy in Shopify (Settings, Apps and sales channels, TackQuote, App proxy)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Apply for net terms"
    },
    {"type":"header","content":"Style","info":"Match theme (or empty) uses your theme's fonts, colors, corners and buttons."},
    {"type":"select","id":"tq_size","label":"Text size","options":[{"value":"0.875","label":"Smaller"},{"value":"1","label":"Match theme"},{"value":"1.125","label":"Larger"},{"value":"1.25","label":"Largest"}],"default":"1"},
    {"type":"select","id":"tq_font","label":"Font","options":[{"value":"theme","label":"Match theme"},{"value":"system","label":"System font"}],"default":"theme"},
    {"type":"color","id":"tq_text","label":"Text color"},
    {"type":"color","id":"tq_bg","label":"Background color"},
    {"type":"color","id":"tq_accent","label":"Button color"},
    {"type":"color","id":"tq_accent_text","label":"Button text color"},
    {"type":"select","id":"tq_radius","label":"Corner radius","options":[{"value":"theme","label":"Match theme"},{"value":"0","label":"Square"},{"value":"4","label":"Slight"},{"value":"8","label":"Rounded"},{"value":"12","label":"More rounded"},{"value":"999","label":"Pill"}],"default":"theme"}
  ]
}
{% endschema %}
