{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | split: '/' | join: '/'
  assign login_url = routes.storefront_login_url | default: routes.account_login_url
-%}

{%- if proxy_path == blank -%}
  {% render 'tackquote-setup', attrs: block.shopify_attributes %}
{%- elsif customer == blank -%}
  {%- capture tq_style -%}{% render 'tackquote-style', s: block.settings %}{%- endcapture -%}
  {%- assign tq_attrs = tq_style | split: '-->' | last | split: '<!--' | first -%}
  <div class="tackquote-block tackquote-qo" {{ tq_attrs }} {{ block.shopify_attributes }}>
  <h3 class="tackquote-qo__heading">{{ block.settings.heading | default: 'Quick order' | escape }}</h3>
  <p>{{ 'tackquote.quick_order.sign_in' | t }}</p>
  <a class="tackquote-price__login" href="{{ login_url }}">{{ 'tackquote.quick_order.login' | t }}</a>
  </div>
{%- else -%}
  {%- capture tackquote_diagnostics -%}{% render 'tackquote-diagnostics' %}{%- endcapture -%}
  {%- capture tq_style -%}{% render 'tackquote-style', s: block.settings %}{%- endcapture -%}
  {%- assign tq_attrs = tq_style | split: '-->' | last | split: '<!--' | first -%}
  <div
  class="tackquote-block tackquote-qo"
  data-tackquote-mode="quick-order"
  data-tackquote-money-format="{{ shop.money_format | escape }}" data-tackquote-shop-currency="{{ shop.currency }}"
  data-tackquote-proxy="{{ proxy_path | escape }}"
  data-tackquote-currency="{{ cart.currency.iso_code }}"
  data-tackquote-design="{% if request.design_mode %}true{% else %}false{% endif %}"
  data-msg-col-sku="{{ 'tackquote.quick_order.col_sku' | t | escape }}"
  data-msg-col-item="{{ 'tackquote.quick_order.col_item' | t | escape }}"
  data-msg-col-qty="{{ 'tackquote.quick_order.col_qty' | t | escape }}"
  data-msg-col-price="{{ 'tackquote.quick_order.col_price' | t | escape }}"
  data-msg-each="{{ 'tackquote.price.each' | t | escape }}"
  data-msg-not-found="{{ 'tackquote.quick_order.not_found' | t | escape }}"
  data-msg-price-at-checkout="{{ 'tackquote.quick_order.price_at_checkout' | t | escape }}"
  data-msg-currency="{{ 'tackquote.currency.quote' | t | escape }}"
  data-msg-limit-min="{{ 'tackquote.quick_order.limit_min' | t | escape }}"
  data-msg-limit-max="{{ 'tackquote.quick_order.limit_max' | t | escape }}"
  data-msg-empty="{{ 'tackquote.quick_order.empty' | t | escape }}"
  data-msg-too-many="{{ 'tackquote.quick_order.too_many' | t | escape }}"
  data-msg-bad-lines="{{ 'tackquote.quick_order.bad_lines' | t | escape }}"
  data-msg-loading="{{ 'tackquote.quick_order.loading' | t | escape }}"
  data-msg-unlinked="{{ 'tackquote.quick_order.unlinked' | t | escape }}"
  data-msg-sign-in="{{ 'tackquote.quick_order.sign_in' | t | escape }}"
  data-msg-error="{{ 'tackquote.quick_order.error' | t | escape }}"
  data-msg-added-cart="{{ 'tackquote.quick_order.added_cart' | t | escape }}"
  data-msg-cart-failed="{{ 'tackquote.quick_order.cart_failed' | t | escape }}"
  data-msg-quote-failed="{{ 'tackquote.quick_order.quote_failed' | t | escape }}"
  {{ tackquote_diagnostics | split: '-->' | last | split: '<!--' | first }}
  {{ tq_attrs }}
  {{ block.shopify_attributes }}
  >
  <h3 class="tackquote-qo__heading">{{ block.settings.heading | default: 'Quick order' | escape }}</h3>
  <label class="tackquote-qo__label" for="tackquote-qo-{{ block.id }}">{{ 'tackquote.quick_order.help' | t }}</label>
  <textarea
  id="tackquote-qo-{{ block.id }}"
  class="tackquote-field tackquote-qo__input"
  rows="6"
  spellcheck="false"
  autocomplete="off"
  placeholder="{{ 'tackquote.quick_order.placeholder' | t | escape }}"
  data-tackquote-qo-input
  ></textarea>
  <div class="tackquote-qo__actions">
  <button type="button" class="tackquote-button tackquote-button--outline" data-tackquote-qo-check>
  {{- 'tackquote.quick_order.check' | t -}}
  </button>
  <button type="button" class="tackquote-button tackquote-button--theme button button--primary btn" data-tackquote-qo-cart disabled>
  {{- 'tackquote.quick_order.add_cart' | t -}}
  </button>
  {%- if block.settings.show_quote -%}
  <button type="button" class="tackquote-button tackquote-button--outline" data-tackquote-qo-quote disabled>
  {{- 'tackquote.quick_order.add_quote' | t -}}
  </button>
  {%- endif -%}
  </div>
  <p class="tackquote-status" data-tackquote-qo-status role="status" aria-live="polite"></p>
  <div class="tackquote-qo__out" data-tackquote-qo-out></div>
  </div>

  {%- if block.settings.show_quote -%}
  {% render 'tackquote-drawer', proxy: proxy_path, attrs: tq_attrs %}
  <script src="{{ 'tackquote-quote.js' | asset_url }}" defer></script>
  {%- endif -%}
  {{ 'tackquote-quick-order.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
  <script src="{{ 'tackquote-theme.js' | asset_url }}" async></script>
{%- endif -%}

{% schema %}
{"name": "Quick Order", "target": "section", "enabled_on": {"templates": ["product", "page"]}, "stylesheet": "tackquote.css", "javascript": "tackquote-quick-order.js","settings":[
    {"type":"paragraph","content":"t:tq.p.quick_order_1"},
    {"type":"text","id":"heading","label":"Heading","default":"Quick order"},
    {"type":"checkbox","id":"show_quote","label":"Show Add all to quote","default":true},
    {"type":"text","id":"proxy_path","label":"t:tq.c.proxy","default":"/apps/tackquote","info":"t:tq.c.proxy_info"},
    {"type":"header","content":"t:tq.s.header","info":"t:tq.s.info"},
    {"type":"select","id":"tq_size","label":"t:tq.s.size","options":[{"value":"0.875","label":"t:tq.s.smaller"},{"value":"1","label":"t:tq.s.match"},{"value":"1.125","label":"t:tq.s.larger"},{"value":"1.25","label":"t:tq.s.largest"}],"default":"1"},
    {"type":"select","id":"tq_font","label":"t:tq.s.font","options":[{"value":"theme","label":"t:tq.s.match"},{"value":"system","label":"t:tq.s.system"}],"default":"theme"},
    {"type":"color","id":"tq_text","label":"t:tq.s.text"},
    {"type":"color","id":"tq_bg","label":"t:tq.s.bg"},
    {"type":"color","id":"tq_accent","label":"t:tq.s.accent"},
    {"type":"color","id":"tq_accent_text","label":"t:tq.s.accent_text"},
    {"type":"select","id":"tq_radius","label":"t:tq.s.radius","options":[{"value":"theme","label":"t:tq.s.match"},{"value":"0","label":"t:tq.s.square"},{"value":"4","label":"t:tq.s.slight"},{"value":"8","label":"t:tq.s.rounded"},{"value":"12","label":"t:tq.s.more_rounded"},{"value":"999","label":"t:tq.s.pill"}],"default":"theme"}
  ]}
{% endschema %}
