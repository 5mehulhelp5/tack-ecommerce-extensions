{%- liquid
  assign proxy_path = block.settings.proxy_path | strip | remove_last: '/'
  assign form_slug = block.settings.form_slug | strip
-%}

{%- # README.md, Liquid design notes: wholesale-signup.liquid (1) -%}

{%- # README.md, Liquid design notes: wholesale-signup.liquid (2) -%}
{%- if proxy_path == blank -%}
  {% render 'tackquote-setup', attrs: block.shopify_attributes %}
{%- else -%}
  {%- liquid
    assign no_form_message = ''
    if request.design_mode
      assign no_form_message = 'tackquote.signup.no_form' | t
    endif
  -%}
  {%- capture tq_style -%}{% render 'tackquote-style', s: block.settings %}{%- endcapture -%}
  {%- assign tq_attrs = tq_style | split: '-->' | last | split: '<!--' | first -%}
  <div
    class="tackquote-block tackquote-signup"
  data-tackquote-mode="signup"
  data-tackquote-proxy="{{ proxy_path | escape }}"
  data-tackquote-form="{{ form_slug | escape }}"
  data-msg-loading="{{ 'tackquote.signup.loading' | t | escape }}"
  data-msg-unavailable="{{ 'tackquote.signup.unavailable' | t | escape }}"
  data-msg-no-form="{{ no_form_message | escape }}"
  data-msg-submitting="{{ 'tackquote.signup.submitting' | t | escape }}"
  data-msg-success="{{ 'tackquote.signup.success' | t | escape }}"
  data-msg-error="{{ 'tackquote.signup.error' | t | escape }}"
  data-msg-required="{{ 'tackquote.signup.required' | t | escape }}"
  data-msg-submit="{{ 'tackquote.signup.submit' | t | escape }}"
  data-msg-choose="{{ 'tackquote.signup.choose' | t | escape }}"
  data-msg-file-type="{{ 'tackquote.signup.file_type' | t | escape }}"
  data-msg-file-size="{{ 'tackquote.signup.file_size' | t | escape }}"
  data-msg-uploading="{{ 'tackquote.signup.uploading' | t | escape }}"
  data-msg-addr_line1="{{ 'tackquote.signup.addr_line1' | t | escape }}"
  data-msg-addr_line2="{{ 'tackquote.signup.addr_line2' | t | escape }}"
  data-msg-addr_city="{{ 'tackquote.signup.addr_city' | t | escape }}"
  data-msg-addr_region="{{ 'tackquote.signup.addr_region' | t | escape }}"
  data-msg-addr_postal-code="{{ 'tackquote.signup.addr_postal_code' | t | escape }}"
  data-msg-addr_country="{{ 'tackquote.signup.addr_country' | t | escape }}"
  {{ tq_attrs }}
  {{ block.shopify_attributes }}
  >
    <h3 class="tackquote-signup__heading">
      {%- # README.md, Liquid design notes: wholesale-signup.liquid (3) -%}
      {%- assign tackquote_label = block.settings.heading | strip -%}
      {%- if tackquote_label == blank or tackquote_label == 'Apply for a wholesale account' -%}
        {%- assign tackquote_label = 'tackquote.signup.heading' | t -%}
      {%- endif -%}
  {{ tackquote_label }}
    </h3>

    {%- if block.settings.intro != blank -%}
      <div class="tackquote-signup__intro">{{ block.settings.intro }}</div>
    {%- endif -%}

    {%- if customer or request.design_mode -%}
      <div class="tackquote-signup__body" data-tackquote-signup-body role="status" aria-live="polite">
        <p class="tackquote-signup__loading">{{ 'tackquote.signup.loading' | t }}</p>
      </div>
    {%- else -%}
      <div class="tackquote-signup__signin">
        <p>{{ 'tackquote.signup.sign_in_first' | t }}</p>
        <p>
          <a class="button" href="{{ routes.storefront_login_url | default: routes.account_login_url }}">{{ 'tackquote.signup.sign_in' | t }}</a>
          {%- if routes.account_register_url != blank %}
            <a class="button button--secondary" href="{{ routes.account_register_url }}">{{ 'tackquote.signup.create_account' | t }}</a>
          {%- endif %}
        </p>
      </div>
    {%- endif -%}
  </div>

  <script src="{{ 'tackquote-signup-fields.js' | asset_url }}" defer></script>
  <script src="{{ 'tackquote-shared.js' | asset_url }}" async></script>
  <script src="{{ 'tackquote-theme.js' | asset_url }}" async></script>
{%- endif -%}

{% schema %}
{"name": "Wholesale signup", "target": "section", "enabled_on": {"templates": ["page", "index"]}, "stylesheet": "tackquote.css", "javascript": "tackquote-signup.js","settings":[
    {"type":"text","id":"form_slug","label":"Specific form (optional)","info":"t:tq.p.wholesale_signup_1"},
    {"type":"text","id":"heading","label":"Heading","default":"Apply for a wholesale account"},
    {"type":"richtext","id":"intro","label":"Introduction"},
    {"type":"text","id":"proxy_path","label":"t:tq.c.proxy","default":"/apps/tackquote","info":"t:tq.c.proxy_info"},
    {"type":"header","content":"t:tq.s.header","info":"t:tq.s.info"},
    {"type":"select","id":"tq_size","label":"t:tq.s.size","options":[{"value":"0.875","label":"t:tq.s.smaller"},{"value":"1","label":"t:tq.s.match"},{"value":"1.125","label":"t:tq.s.larger"},{"value":"1.25","label":"t:tq.s.largest"}],"default":"1"},
    {"type":"select","id":"tq_font","label":"t:tq.s.font","options":[{"value":"theme","label":"t:tq.s.match"},{"value":"system","label":"t:tq.s.system"}],"default":"theme"},
    {"type":"color","id":"tq_text","label":"t:tq.s.text"},
    {"type":"color","id":"tq_bg","label":"t:tq.s.bg"},
    {"type":"color","id":"tq_accent","label":"t:tq.s.accent"},
    {"type":"color","id":"tq_accent_text","label":"t:tq.s.accent_text"},
    {"type":"select","id":"tq_radius","label":"t:tq.s.radius","options":[{"value":"theme","label":"t:tq.s.match"},{"value":"0","label":"t:tq.s.square"},{"value":"4","label":"t:tq.s.slight"},{"value":"8","label":"t:tq.s.rounded"},{"value":"12","label":"t:tq.s.more_rounded"},{"value":"999","label":"t:tq.s.pill"}],"default":"theme"}
  ]}
{% endschema %}
